# Copy this file to .env.local and fill in values.
# .env.local is gitignored and never committed.

# LLM mode: "mock" (default, no API key needed) or "real" (requires OpenAI below).
LLM_MODE=mock

# OpenAI is used only by server-side code when LLM_MODE=real.
# Do not expose provider keys with NEXT_PUBLIC_* names.
# OPENAI_API_KEY=sk-...
