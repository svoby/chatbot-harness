# Copy this file to .env.local and fill in values.
# .env.local is gitignored and never committed.

# LLM mode: "mock" (default, no API key needed) or "real" (requires OpenAI below).
LLM_MODE=mock

# OpenAI is used only by server-side code when LLM_MODE=real.
# OPENAI_MODEL is optional and defaults to gpt-4o-mini when omitted.
# LLM_MODEL is also supported as a fallback alias.
# Do not expose provider keys or model config with NEXT_PUBLIC_* names.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Managed Postgres connection string for server-side DB operations.
# Keep this secret server-side only and never expose through NEXT_PUBLIC_*.
# Example: postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
# DATABASE_URL=postgres://...
